# Bundle third-party vendor assets in ui/vendor/ into css/min.css and js/min.js.
# CasTTY's own styles and code remain unminified in css/player.css and js/player.js.

JQUERY_VER = 3.7.1
JQUERY_URL = https://registry.npmjs.org/jquery/-/jquery-$(JQUERY_VER).tgz
JQUERY_SHA256 = 68a9f787516da47c680e09c187bcbac4536b6f85d90eb882844e12919e583f53

RANGESLIDER_VER = 2.3.3
RANGESLIDER_URL = https://registry.npmjs.org/rangeslider.js/-/rangeslider.js-$(RANGESLIDER_VER).tgz
RANGESLIDER_SHA256 = 192059b07da769214ee486e84d8e7d28d076f95fdd9470df125d0441d94ab800

XTERM_VER = 2.4.0
XTERM_URL = https://registry.npmjs.org/xterm/-/xterm-$(XTERM_VER).tgz
XTERM_SHA256 = 93edca9f0fb6dcb525ad2a806f43eed332f8c895de29eb40afb333871876a0cb

VENDOR_CSS = \
	vendor/rangeslider-$(RANGESLIDER_VER).css \
	vendor/xterm-$(XTERM_VER).css

VENDOR_JS = \
	vendor/jquery-$(JQUERY_VER).min.js \
	vendor/rangeslider-$(RANGESLIDER_VER).min.js \
	vendor/xterm-$(XTERM_VER).js

all: css/min.css js/min.js

css/min.css: $(VENDOR_CSS) Makefile
	@printf '/* Generated by ui/Makefile: rangeslider.js %s + xterm %s */\n' \
	    '$(RANGESLIDER_VER)' '$(XTERM_VER)' > $@.tmp
	@awk '{ buf = buf $$0 "\n" } END { \
		n = length(buf); out = ""; q = ""; i = 1; \
		while (i <= n) { \
			c = substr(buf, i, 1); c2 = substr(buf, i, 2); \
			if (q != "") { \
				out = out c; \
				if (c == "\\" && i < n) { i++; out = out substr(buf, i, 1); } \
				else if (c == q) { q = ""; } \
				i++; \
			} else if (c == "\"" || c == "\047") { \
				q = c; out = out c; i++; \
			} else if (c2 == "/*") { \
				i += 2; \
				while (i <= n && substr(buf, i, 2) != "*/") i++; \
				i += 2; \
			} else if (c ~ /[ \t\r\n]/) { \
				while (i <= n && substr(buf, i, 1) ~ /[ \t\r\n]/) i++; \
				last = substr(out, length(out), 1); \
				nextc = (i <= n) ? substr(buf, i, 1) : ""; \
				if (last != "" && last !~ /[{};,]/ && nextc !~ /[{};,]/) out = out " "; \
			} else { \
				out = out c; i++; \
			} \
		} \
		print out; \
	}' $(VENDOR_CSS) >> $@.tmp
	@mv $@.tmp $@

js/min.js: $(VENDOR_JS) Makefile
	@printf '/* Generated by ui/Makefile: jquery %s + rangeslider.js %s + xterm %s */\n' \
	    '$(JQUERY_VER)' '$(RANGESLIDER_VER)' '$(XTERM_VER)' > $@.tmp
	@for f in $(VENDOR_JS); do \
		sed '/^\/\/# sourceMappingURL=/d' "$$f" >> $@.tmp; \
		printf '\n;\n' >> $@.tmp; \
	done
	@mv $@.tmp $@

fetch-vendor:
	@tmpdir=$$(mktemp -d); \
	trap 'rm -rf "$$tmpdir"' EXIT INT TERM; \
	check_sha256() { \
		if command -v sha256sum >/dev/null 2>&1; then \
			actual=$$(sha256sum "$$1" | awk '{print $$1}'); \
		elif command -v shasum >/dev/null 2>&1; then \
			actual=$$(shasum -a 256 "$$1" | awk '{print $$1}'); \
		else \
			actual=$$(sha256 -q "$$1"); \
		fi; \
		if [ "$$actual" != "$$2" ]; then \
			echo "SHA-256 mismatch for $$1: expected $$2, got $$actual" >&2; \
			exit 1; \
		fi; \
	}; \
	mkdir -p vendor; \
	curl -fsSL '$(JQUERY_URL)' -o "$$tmpdir/jquery.tgz"; \
	check_sha256 "$$tmpdir/jquery.tgz" '$(JQUERY_SHA256)'; \
	mkdir -p "$$tmpdir/jquery" && tar -xzf "$$tmpdir/jquery.tgz" -C "$$tmpdir/jquery"; \
	cp "$$tmpdir/jquery/package/dist/jquery.min.js" 'vendor/jquery-$(JQUERY_VER).min.js'; \
	curl -fsSL '$(RANGESLIDER_URL)' -o "$$tmpdir/rangeslider.tgz"; \
	check_sha256 "$$tmpdir/rangeslider.tgz" '$(RANGESLIDER_SHA256)'; \
	mkdir -p "$$tmpdir/rangeslider" && tar -xzf "$$tmpdir/rangeslider.tgz" -C "$$tmpdir/rangeslider"; \
	cp "$$tmpdir/rangeslider/package/dist/rangeslider.min.js" 'vendor/rangeslider-$(RANGESLIDER_VER).min.js'; \
	cp "$$tmpdir/rangeslider/package/dist/rangeslider.css" 'vendor/rangeslider-$(RANGESLIDER_VER).css'; \
	curl -fsSL '$(XTERM_URL)' -o "$$tmpdir/xterm.tgz"; \
	check_sha256 "$$tmpdir/xterm.tgz" '$(XTERM_SHA256)'; \
	mkdir -p "$$tmpdir/xterm" && tar -xzf "$$tmpdir/xterm.tgz" -C "$$tmpdir/xterm"; \
	cp "$$tmpdir/xterm/package/dist/xterm.js" 'vendor/xterm-$(XTERM_VER).js'; \
	cp "$$tmpdir/xterm/package/dist/xterm.css" 'vendor/xterm-$(XTERM_VER).css'

clean:
	rm -f css/min.css js/min.js css/min.css.tmp js/min.js.tmp

.PHONY: all fetch-vendor clean
